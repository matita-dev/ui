{
  "name": "@matita/ui",
  "version": "0.1.0",
  "description": "Pencil-style React components: crisp text and behavior, with borders, fills and checks drawn by code.",
  "homepage": "https://matita.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matita-dev/ui.git"
  },
  "bugs": {
    "url": "https://github.com/matita-dev/ui/issues"
  },
  "author": "herocreativ <hello@matita.dev> (https://herocreativ.com)",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "pencil",
    "sketch",
    "blueprint",
    "matita"
  ],
  "license": "MIT",
  "type": "module",
